default_platform(:ios)
skip_docs

PROJECT = "SampleApp/Viafoura.xcodeproj"
SCHEME = "Viafoura"
OUTPUT_DIR = "fastlane/build"
XCFRAMEWORK = "ViafouraSDK.xcframework"

platform :ios do
  desc "Build the sample app with the next version and upload it to TestFlight"
  desc "The version bump is only applied for the build, never committed: TestFlight holds the latest build number"
  desc "Options:"
  desc "  build_number:<n>  use this build number instead of latest TestFlight build + 1"
  desc "  version:<x.y.z>   use this marketing version instead of 1.0.<build_number>"
  desc "  changelog:<text>  'What to Test' notes (defaults to the last 10 commit subjects)"
  desc "  skip_waiting:true don't wait for App Store Connect processing (no 'What to Test' notes)"
  desc "  core_xcframework:<path>  link this ViafouraSDK.xcframework (e.g. built from sdk-ios-core develop)"
  desc "                           instead of the released sdk-ios package"
  desc "  core_label:<text>        describes that framework at the top of the 'What to Test' notes"
  lane :beta do |options|
    ensure_git_status_clean

    api_key = asc_api_key

    build_number = (options[:build_number] || next_build_number(api_key)).to_i
    version = options[:version] || "1.0.#{build_number}"
    UI.message("Releasing #{version} (#{build_number})")

    set_sample_app_version(version, build_number)

    begin
      use_core_xcframework(options[:core_xcframework]) if options[:core_xcframework]

      build_app(
        project: PROJECT,
        scheme: SCHEME,
        configuration: "Release",
        export_method: "app-store",
        output_directory: OUTPUT_DIR,
        clean: true,
        xcargs: provisioning_xcargs
      )

      skip_waiting = options[:skip_waiting].to_s == "true"
      upload_to_testflight(
        api_key: api_key,
        changelog: skip_waiting ? nil : what_to_test(options),
        skip_waiting_for_build_processing: skip_waiting
      )
    ensure
      reset_git_repo(force: true, files: [PROJECT])
      restore_core_xcframework if options[:core_xcframework]
    end
  end
end

def asc_api_key
  key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
  return nil if key_id.to_s.empty?

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
    key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
    key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
    is_key_content_base64: ENV["APP_STORE_CONNECT_API_KEY_BASE64"] == "true"
  )
end

def next_build_number(api_key)
  latest = latest_testflight_build_number(api_key: api_key, initial_build_number: 0)
  [latest.to_i, current_build_number].max + 1
end

def current_build_number
  File.read(project_path).scan(/CURRENT_PROJECT_VERSION = (\d+);/).flatten.map(&:to_i).max || 0
end

# Only the app target's Debug/Release configurations set these keys.
def set_sample_app_version(version, build_number)
  pbxproj = File.read(project_path)
  pbxproj.gsub!(/MARKETING_VERSION = [^;]+;/, "MARKETING_VERSION = #{version};")
  pbxproj.gsub!(/CURRENT_PROJECT_VERSION = [^;]+;/, "CURRENT_PROJECT_VERSION = #{build_number};")
  File.write(project_path, pbxproj)
end

def project_path
  File.join(FastlaneCore::FastlaneFolder.path, "..", PROJECT, "project.pbxproj")
end

# Automatic signing: on a machine without an Xcode account signed in (e.g. CI),
# xcodebuild needs the API key to create/download profiles.
def provisioning_xcargs
  args = ["-allowProvisioningUpdates"]
  key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"]
  if key_path && ENV["APP_STORE_CONNECT_API_KEY_ID"]
    args += [
      "-authenticationKeyPath #{File.expand_path(key_path).shellescape}",
      "-authenticationKeyID #{ENV['APP_STORE_CONNECT_API_KEY_ID']}",
      "-authenticationKeyIssuerID #{ENV['APP_STORE_CONNECT_API_ISSUER_ID']}"
    ]
  end
  args.join(" ")
end

# The sample app normally takes ViafouraCore from the released sdk-ios package. For a
# build against another framework, put it in this checkout and point the app at the
# checkout as a local package for the duration of the build.
def use_core_xcframework(path)
  source = File.expand_path(path)
  UI.user_error!("No xcframework at #{source}") unless File.directory?(source)

  destination = File.join(repo_root, XCFRAMEWORK)
  FileUtils.rm_rf(destination)
  FileUtils.cp_r(source, destination)

  project = Xcodeproj::Project.open(File.dirname(project_path))
  remote = project.root_object.package_references.find do |ref|
    ref.isa == "XCRemoteSwiftPackageReference" && ref.repositoryURL.to_s.match?(%r{viafoura/sdk-ios(\.git)?/?$})
  end
  UI.user_error!("The sample app has no sdk-ios package reference to replace") unless remote

  local = project.new(Xcodeproj::Project::Object::XCLocalSwiftPackageReference)
  local.relative_path = ".."
  project.root_object.package_references << local
  project.objects.select { |o| o.isa == "XCSwiftPackageProductDependency" && o.package == remote }
         .each { |dependency| dependency.package = local }
  project.root_object.package_references.delete(remote)
  remote.remove_from_project
  project.save

  UI.message("Linking #{source} through a local ViafouraCore package")
end

def restore_core_xcframework
  Dir.chdir(repo_root) do
    sh("git", "checkout", "--", XCFRAMEWORK, log: false)
    sh("git", "clean", "-fdq", "--", XCFRAMEWORK, log: false)
  end
end

def repo_root
  File.expand_path("..", FastlaneCore::FastlaneFolder.path)
end

def what_to_test(options)
  notes = options[:changelog] || recent_changes
  label = options[:core_label].to_s
  label.empty? ? notes : "#{label}\n\n#{notes}"
end

def recent_changes
  notes = sh("git log -10 --no-merges --format='- %s'", log: false).strip
  notes.empty? ? "Sample app build" : notes
end
